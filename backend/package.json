{
  "name": "tienda-perritos-backend",
  "version": "1.0.0",
  "description": "API backend para tienda de alimentos para perritos",
  "main": "server.js",
  "scripts": {
    "test": "jest --coverage --coverageReporters=lcov --coverageReporters=json-summary --coverageReporters=text"
    },
    "jest": {
    "coverageThreshold": { "global": { "lines": 70 } }
    },

  "dependencies": {
    "body-parser": "^1.20.9",
    "cors": "^2.8.5",
    "express": "^4.19.0",
    "mysql2": "^3.9.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "app.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "branches": 70,
        "functions": 80
      }
    }
  }
}
